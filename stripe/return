// app/stripe/return/page.tsx
"use client";

import { Suspense, useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { supabase } from "@/lib/supabaseClient";

const SUBS_TABLE = "user_subscriptions";
const ACTIVE_STATUSES = new Set(["active", "trialing"]);

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

function isActiveStripeStatus(status?: string | null) {
  if (!status) return false;
  return ACTIVE_STATUSES.has(String(status).toLowerCase());
}

function LoadingScreen() {
  return (
    <main
      style={{
        minHeight: "100vh",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        background: "#020617",
        color: "#e5e7eb",
        fontFamily:
          "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        padding: 24,
      }}
    >
      <div style={{ textAlign: "center", maxWidth: 520 }}>
        <div
          style={{
            width: 48,
            height: 48,
            borderRadius: "50%",
            border: "4px solid rgba(255,255,255,0.2)",
            borderTopColor: "#fb7185",
            margin: "0 auto 16px",
            animation: "spin 1s linear infinite",
          }}
        />
        <p style={{ margin: 0, fontSize: 18 }}>Finalisation de ton paiement…</p>
        <p style={{ opacity: 0.75, fontSize: 13, marginTop: 8 }}>
          On confirme ton abonnement et on te redirige automatiquement.
        </p>

        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    </main>
  );
}

function StripeReturnInner() {
  const router = useRouter();
  const searchParams = useSearchParams();

  useEffect(() => {
    let cancelled = false;

    const lang = searchParams.get("lang") || "fr";
    const sessionId = searchParams.get("session_id") || "";

    const go = (path: string) => {
      const qs = new URLSearchParams();
      qs.set("lang", lang);
      if (sessionId) qs.set("session_id", sessionId);
      router.replace(`${path}?${qs.toString()}`);
    };

    const ensureLoggedInUserId = async () => {
      // attend la session côté client (cookie supabase)
      for (let i = 0; i < 25; i++) {
        if (cancelled) return "";

        const { data, error } = await supabase.auth.getSession();
        if (error) console.error("[stripe/return] getSession error:", error);

        const user = data?.session?.user;
        if (user?.id) return user.id;

        await sleep(250);
      }
      return "";
    };

    const callSync = async () => {
      if (!sessionId) return;

      try {
        const res = await fetch("/api/stripe/sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ session_id: sessionId }),
        });

        // pas bloquant: on continue même si ça échoue
        if (!res.ok) {
          const txt = await res.text().catch(() => "");
          console.error("[stripe/return] sync failed:", res.status, txt);
        }
      } catch (e) {
        console.error("[stripe/return] sync exception:", e);
      }
    };

    const waitForSubActive = async (userId: string) => {
      // on laisse quelques secondes à Supabase (sync + upsert) pour se refléter
      for (let i = 0; i < 30; i++) {
        if (cancelled) return false;

        const { data, error } = await supabase
          .from(SUBS_TABLE)
          .select("stripe_status,current,pricing_plan_id")
          .eq("user_id", userId)
          .maybeSingle();

        if (error) {
          console.error("[stripe/return] sub fetch error:", error);
        } else if (data) {
          const stripeStatus = (data as any).stripe_status as
            | string
            | null
            | undefined;
          const current = (data as any).current as boolean | null | undefined;

          const active =
            (typeof current === "boolean" && current === true) ||
            isActiveStripeStatus(stripeStatus);

          if (active) return true;
        }

        await sleep(400);
      }
      return false;
    };

    const run = async () => {
      // 1) user connecté ?
      const userId = await ensureLoggedInUserId();
      if (!userId) {
        go("/login");
        return;
      }

      // 2) SYNC immédiat Stripe -> Supabase (ne dépend plus du webhook)
      await callSync();

      // 3) check rapide si l'abonnement est actif
      await waitForSubActive(userId);

      // 4) entrer dans l'app
      go("/my-amoria");
    };

    run();

    return () => {
      cancelled = true;
    };
  }, [router, searchParams]);

  return <LoadingScreen />;
}

export default function StripeReturnPage() {
  return (
    <Suspense fallback={<LoadingScreen />}>
      <StripeReturnInner />
    </Suspense>
  );
}
