"use client";

import { useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { supabase } from "@/lib/supabaseClient";

const SUBS_TABLE = "user_subscriptions";

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

export default function StripeReturnPage() {
  const router = useRouter();
  const searchParams = useSearchParams();

  useEffect(() => {
    let cancelled = false;

    const run = async () => {
      const lang = searchParams.get("lang") || "fr";
      const sessionId = searchParams.get("session_id") || "";

      // 1) Attendre la session Supabase (user connecté)
      let userId = "";
      for (let i = 0; i < 20; i++) {
        if (cancelled) return;

        const { data, error } = await supabase.auth.getSession();
        if (error) console.error("getSession error:", error);

        const user = data?.session?.user;
        if (user?.id) {
          userId = user.id;
          break;
        }

        await sleep(300);
      }

      if (!userId) {
        router.replace(`/login?lang=${encodeURIComponent(lang)}`);
        return;
      }

      // 2) Attendre que le webhook écrive l’abonnement
      // ✅ Nouveau modèle: status ("active" / "trialing")
      // (si ton ancien modèle "current" existe encore, on le vérifie aussi)
      for (let i = 0; i < 30; i++) {
        if (cancelled) return;

        const { data, error } = await supabase
          .from(SUBS_TABLE)
          .select("status, current, pricing_plan_id, stripe_subscription_id")
          .eq("user_id", userId)
          .maybeSingle();

        if (error) {
          // Si la colonne "current" n'existe pas, Supabase peut retourner une erreur.
          // Dans ce cas, on refait une requête sans "current".
          const msg = String((error as any)?.message || "");
          if (msg.toLowerCase().includes("current")) {
            const retry = await supabase
              .from(SUBS_TABLE)
              .select("status, pricing_plan_id, stripe_subscription_id")
              .eq("user_id", userId)
              .maybeSingle();

            if (retry.error) console.error("subscription fetch error:", retry.error);

            const st = (retry.data as any)?.status;
            const isActive = st === "active" || st === "trialing";

            if (isActive) {
              const qs = new URLSearchParams();
              qs.set("lang", lang);
              if (sessionId) qs.set("session_id", sessionId);
              router.replace(`/my-amoria?${qs.toString()}`);
              return;
            }

            await sleep(500);
            continue;
          }

          console.error("subscription fetch error:", error);
        }

        const cur = (data as any)?.current;
        const st = (data as any)?.status;

        const isActive =
          (typeof cur === "boolean" && cur === true) ||
          (typeof st === "string" && (st === "active" || st === "trialing"));

        if (isActive) {
          const qs = new URLSearchParams();
          qs.set("lang", lang);
          if (sessionId) qs.set("session_id", sessionId);
          router.replace(`/my-amoria?${qs.toString()}`);
          return;
        }

        await sleep(500);
      }

      // 3) Fallback : webhook lent / souci -> on continue quand même
      router.replace(`/my-amoria?lang=${encodeURIComponent(lang)}`);
    };

    run();
    return () => {
      cancelled = true;
    };
  }, [router, searchParams]);

  return (
    <main
      style={{
        minHeight: "100vh",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        background: "#020617",
        color: "#e5e7eb",
        fontFamily:
          "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      }}
    >
      <div style={{ textAlign: "center" }}>
        <div
          style={{
            width: 48,
            height: 48,
            borderRadius: "50%",
            border: "4px solid rgba(255,255,255,0.2)",
            borderTopColor: "#fb7185",
            margin: "0 auto 1rem",
            animation: "spin 1s linear infinite",
          }}
        />
        <p>Finalisation de ton paiement…</p>
        <p style={{ opacity: 0.7, fontSize: 13 }}>
          On active ton forfait et on te redirige automatiquement.
        </p>

        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    </main>
  );
}
