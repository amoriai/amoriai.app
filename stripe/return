"use client";

import { useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { supabase } from "@/lib/supabaseClient";

const SUBS_TABLE = "user_subscriptions";

const ACTIVE_STATUSES = new Set(["active", "trialing"]);

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

function isStripeActive(status?: string | null) {
  if (!status) return false;
  return ACTIVE_STATUSES.has(String(status).toLowerCase());
}

export default function StripeReturnPage() {
  const router = useRouter();
  const searchParams = useSearchParams();

  useEffect(() => {
    let cancelled = false;

    const goLogin = (lang: string) =>
      router.replace(`/login?lang=${encodeURIComponent(lang)}`);

    const goApp = (lang: string, sessionId?: string) => {
      const qs = new URLSearchParams();
      qs.set("lang", lang);
      if (sessionId) qs.set("session_id", sessionId);
      router.replace(`/my-amoria?${qs.toString()}`);
    };

    const run = async () => {
      const lang = searchParams.get("lang") || "fr";
      const sessionId = searchParams.get("session_id") || "";

      // 1) Attendre l’utilisateur connecté
      let userId = "";
      for (let i = 0; i < 25; i++) {
        if (cancelled) return;

        const { data, error } = await supabase.auth.getSession();
        if (error) console.error("supabase.auth.getSession error:", error);

        const user = data?.session?.user;
        if (user?.id) {
          userId = user.id;
          break;
        }

        await sleep(250);
      }

      if (!userId) {
        goLogin(lang);
        return;
      }

      // 2) Attendre que la ligne user_subscriptions soit à jour
      // IMPORTANT: dans ta table, tu as "stripe_status" (pas "status").
      for (let i = 0; i < 40; i++) {
        if (cancelled) return;

        const { data, error } = await supabase
          .from(SUBS_TABLE)
          .select(
            [
              "stripe_status",
              "current",
              "pricing_plan_id",
              "stripe_subscription_id",
              "stripe_customer_id",
              "current_period_end",
              "canceled_at",
              "stripe_checkout_session_id",
              "stripe_price_id",
            ].join(",")
          )
          .eq("user_id", userId)
          .maybeSingle();

        // Si tu as une erreur ici, c’est souvent une policy RLS qui bloque le SELECT.
        if (error) {
          console.error("user_subscriptions fetch error:", error);
          // On réessaie un peu, puis fallback.
        } else {
          const stripeStatus = (data as any)?.stripe_status as string | null | undefined;
          const cur = (data as any)?.current as boolean | null | undefined;

          const active =
            (typeof cur === "boolean" && cur === true) || isStripeActive(stripeStatus);

          if (active) {
            goApp(lang, sessionId);
            return;
          }
        }

        await sleep(500);
      }

      // 3) Fallback: si webhook lent ou RLS bloque, on laisse passer vers l’app
      goApp(lang, sessionId);
    };

    run();

    return () => {
      cancelled = true;
    };
  }, [router, searchParams]);

  return (
    <main
      style={{
        minHeight: "100vh",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        background: "#020617",
        color: "#e5e7eb",
        fontFamily:
          "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      }}
    >
      <div style={{ textAlign: "center", padding: 24, maxWidth: 520 }}>
        <div
          style={{
            width: 48,
            height: 48,
            borderRadius: "50%",
            border: "4px solid rgba(255,255,255,0.2)",
            borderTopColor: "#fb7185",
            margin: "0 auto 1rem",
            animation: "spin 1s linear infinite",
          }}
        />
        <p style={{ margin: 0, fontSize: 18 }}>Finalisation de ton paiement…</p>
        <p style={{ opacity: 0.75, fontSize: 13, marginTop: 8 }}>
          On confirme ton abonnement et on te redirige automatiquement.
        </p>

        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    </main>
  );
}
